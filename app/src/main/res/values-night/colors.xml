<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark palette mirrors OmniTavern's built-in "经典黑" (classic-dark) preset:
  GitHub-dark-style blue-gray neutrals with a #2F81F7 accent. Every key
  mirrors values/colors.xml so the DayNight theme swaps automatically.
  primary_dark doubles as the light accent text used on primary_soft chips.
-->
<resources>
    <color name="primary">#2F81F7</color>
    <color name="primary_dark">#79C0FF</color>
    <color name="primary_soft">#2E79C0FF</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="background">#171B20</color>
    <color name="surface">#1E232A</color>
    <color name="input_background">#1D2229</color>
    <color name="border">#30363D</color>
    <color name="divider">#14F0F6FC</color>
    <color name="text_primary">#F0F6FC</color>
    <color name="text_secondary">#8B98A7</color>
    <color name="warning">#FBBF24</color>
    <color name="success">#2EA043</color>
</resources>
